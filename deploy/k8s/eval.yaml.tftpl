apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  name: eval-reports
spec:
  accessModes: [ReadWriteMany]
  storageClassName: azurefile-csi
  resources:
    requests: {storage: 5Gi}
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: eval-benchmark
spec:
  schedule: '0 0 1 1 *'
  suspend: true
  concurrencyPolicy: Forbid
  jobTemplate:
    spec:
      backoffLimit: 0
      activeDeadlineSeconds: 3600
      template:
        metadata:
          labels: {app: eval-benchmark}
        spec:
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            runAsUser: 10001
            runAsGroup: 10001
            fsGroup: 10001
          containers:
            - name: benchmark
              image: ${eval_image}
              command: [python, -m, llm_codegen_eval.serving.benchmark]
              args: [--base-url, 'http://vllm:8000/v1', --concurrency, '4', --output-dir, /reports/serving, --environment, 'AKS; record GPU SKU and cache policy in run evidence']
              resources:
                requests: {cpu: '250m', memory: 256Mi}
                limits: {cpu: '1', memory: 1Gi}
              securityContext:
                allowPrivilegeEscalation: false
                capabilities: {drop: [ALL]}
              volumeMounts:
                - {name: reports, mountPath: /reports}
          volumes:
            - name: reports
              persistentVolumeClaim: {claimName: eval-reports}
