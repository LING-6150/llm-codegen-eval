  {
    "case_id": "html_001",
    "prompt": "A countdown timer app",
    "code_type": "html",
    "difficulty": "medium",
    "required_checks": [
      {
        "type": "tag_exists",
        "selector": "input[type='datetime-local'], input[type='date'], input[type='number']",
        "description": "Input for target time/date/duration"
      },
      {
        "type": "tag_exists",
        "selector": "button, .start-btn, [onclick]",
        "description": "Start button or interactive trigger"
      },
      {
        "type": "regex_match",
        "pattern": "setInterval|setTimeout|requestAnimationFrame",
        "description": "Uses JS timer to update countdown"
      },
      {
        "type": "regex_match",
        "pattern": "<(span|div|h[1-6])[^>]*>[^<]*\\d+[:：]\\d+",
        "description": "Display element with time format (00:00)"
      }
    ],
    "optional_checks": [
      {
        "type": "regex_match",
        "pattern": "clearInterval|clearTimeout",
        "description": "Cleanup timer on completion"
      },
      {
        "type": "regex_match",
        "pattern": "padStart|padEnd|String\\(.*\\)\\.padStart",
        "description": "Time formatting (00:00 format)"
      }
    ],
    "forbidden_patterns": [
      "eval\\s*\\(",
      "document\\.write",
      "innerHTML\\s*=\\s*[\"'][^\"']*\\$\\{"
    ],
    "tags": ["interactive", "timer", "javascript"],
    "notes": "Tests basic interactivity + JS timer usage. Original duration: 2.5min, tokens: 5376"
  },
